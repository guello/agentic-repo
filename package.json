{
  "name": "agentic-repo",
  "version": "0.0.0",
  "description": "Automate the issue and pull request lifecycle with any coding agent, locally or in CI.",
  "keywords": [
    "agents",
    "github",
    "github-actions",
    "github-projects",
    "issues",
    "pull-requests"
  ],
  "homepage": "https://github.com/guello/agentic-repo#readme",
  "bugs": {
    "url": "https://github.com/guello/agentic-repo/issues"
  },
  "license": "MIT",
  "author": "Gabriele Canepa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guello/agentic-repo.git"
  },
  "bin": {
    "agentic-repo": "dist/agentic-repo.mjs"
  },
  "files": [
    "dist",
    "schema.json",
    "templates"
  ],
  "type": "module",
  "scripts": {
    "build": "tsdown && node scripts/generate-schema.ts",
    "check": "pnpm run --parallel \"/^check:/\"",
    "check:format": "oxfmt --check",
    "check:lint": "oxlint",
    "check:types": "tsc --noEmit",
    "ci": "pnpm run check && pnpm run test && pnpm run build",
    "fix": "oxlint --fix && oxfmt",
    "prepack": "pnpm run build",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "devDependencies": {
    "@guello/oxfmt-config": "^0.1.0",
    "@guello/oxlint-config": "^0.2.0",
    "@guello/tsconfig": "^0.1.0",
    "@types/node": "^22.20.5",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2005",
    "tsdown": "0.23.4",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.16.1"
}
