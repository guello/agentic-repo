{
  "name": "agentic-github",
  "version": "0.0.0",
  "description": "Run software work through GitHub issues and pull requests, with any coding agent, local or in CI.",
  "keywords": [
    "agents",
    "github",
    "github-actions",
    "github-projects",
    "issues",
    "pull-requests"
  ],
  "homepage": "https://github.com/guello/agentic-github#readme",
  "bugs": {
    "url": "https://github.com/guello/agentic-github/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guello/agentic-github.git"
  },
  "license": "MIT",
  "author": "Gabriele Canepa",
  "type": "module",
  "bin": {
    "agentic-github": "dist/agentic-github.mjs"
  },
  "files": [
    "dist",
    "schema",
    "defaults",
    "templates"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "build": "tsdown",
    "check": "pnpm run --parallel \"/^check:/\"",
    "check:format": "oxfmt --check",
    "check:lint": "oxlint",
    "check:types": "tsc --noEmit",
    "ci": "pnpm run check && pnpm run test && pnpm run build",
    "fix": "oxlint --fix && oxfmt",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "tsdown": "0.23.4",
    "typescript": "^7.0.2"
  }
}
