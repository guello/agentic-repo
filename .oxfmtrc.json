{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": ["dist", "schema.json"],
  "arrowParens": "avoid",
  "semi": false,
  "singleQuote": true,
  "trailingComma": "es5",
  "sortImports": {
    "groups": [
      ["side_effect", "side_effect_style", "style"],
      "builtin",
      "external",
      ["index", "sibling", "parent"],
      "unknown"
    ]
  }
}
